[["Kural 33: ஒல்லும் வகையான் (Ollum vakaiyan)","Tiruvalluvar","tiruvalluvar/68"],["Kural 673: ஒல்லும்வா யெல்லாம் (Ollumva yellam)","Tiruvalluvar","tiruvalluvar/708"],["Kural 714: ஒளியார்முன் ஒள்ளிய (Oliyarmun olliya)","Tiruvalluvar","tiruvalluvar/749"],["Kural 818: ஒல்லும் கருமம் (Ollum karumam)","Tiruvalluvar","tiruvalluvar/853"],["Purananuru 196: ஒல்லுவது ஒல்லும் (Olluvatu ollum)","Purananuru Poets","purananuru-poets/185"],["ಆರಾರ ಮನದಲ್ಲಿ ಏನೇನಿಹುದೆಂದರಿಯೆ. ಒಳ್ಳಿಹರೆಂದೆನಲಮ್ಮೆ (Ārāra manadalli ēnēnihudeṃdariye oḷḷihareṃdenalamme)","Basavanna","basavanna/204"],["ಒಲ್ಲೆನಯ್ಯಾ ನಿಮ್ಮವರಲ್ಲದವರ (Ollenayyā nimmavaralladavara)","Basavanna","basavanna/357"],["ಒಳ್ಳಿಹ ಮೈಲಾರನ ಒಳಗೆಲ್ಲ ಸಣಬು (Oḷḷiha mailārana oḷagella saṇabu)","Basavanna","basavanna/363"],["ಒಲಿದ ಗಂಡನೊಮ್ಮೆ ಒಲ್ಲದಿಪ್ಪ ಕಂಡವ್ವಾ. ತಪ್ಪೆನ್ನದು (Olida gaṃḍanomme olladippa kaṃḍavvā tappennadu)","Basavanna","basavanna/369"],["ಒಲ್ಲೆನೆಂಬುದು ವೈರಾಗ್ಯ (Olleneṃbudu vairāgya)","Basavanna","basavanna/380"],["ಭಕ್ತರನಲ್ಲದೆ ಒಲ್ಲೆವೆಂದೆಂಬಿರಿ (Bhaktaranallade olleveṃdeṃbiri)","Basavanna","basavanna/818"],["ಮುನ್ನಿನ ಆದ್ಯರ ಪಥಂಗಳು ಇನ್ನಾರಿಗೂ ಅಳವಡವು ನೋಡಾ. ಬಲ್ಲೆನಾಗಿ ಒಲ್ಲೆನು ಅವರ (Munnina ādyara pathaṃgaḷu innārigū aḷavaḍavu nōḍā ballenāgi ollenu avara)","Basavanna","basavanna/887"],["Kanteletar I.171: Mipä paimenten olla?","Kanteletar (Finnish folk songs, ed. Lönnrot)","kanteletar/170"],["„Börnin öll eru dáin“","Matthías Jochumsson","matthias-jochumsson/29"],["Queridiña d’ os meus ollos","Rosalía de Castro","rosalia-de-castro/23"],["Opulent Ollie","Carolyn Wells","wells_c/12"],["Ollie McGee","Edgar Lee Masters","masters/2"],["하다못해 죽어 달려가 올라 (Hadamotae jugeo dallyeoga olla)","Kim Sowol","kim-sowol/117"]]